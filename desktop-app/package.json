{
  "name": "supernova-desktop",
  "version": "2026.07.17",
  "description": "Supernova Official Desktop Client",
  "author": "Supernova <hello@supernova.com>",
  "homepage": "https://github.com/soltros/Supernova",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test": "node --test security.test.js"
  },
  "build": {
    "appId": "com.supernova.desktop",
    "productName": "Supernova",
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "pacman"
      ],
      "category": "Audio",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  }
}
