# =============================================================================
# Supernova — Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: JWT Authentication Secret
# Used to sign and verify all login tokens. The server will REFUSE TO START
# if this is missing or shorter than 32 characters.
#
# Generate a strong secret with:
#   openssl rand -hex 32
#
# Example (do NOT use this exact value in production):
JWT_SECRET=replace_this_with_output_of_openssl_rand_hex_32

# -----------------------------------------------------------------------------
# RECOMMENDED: Subsonic reversible-credential key
# Used only for the encrypted password copy required by Subsonic token+salt
# authentication. Keep this separate from JWT_SECRET so signing-key rotation
# does not invalidate Subsonic compatibility credentials.
#
# Generate independently with:
#   openssl rand -hex 32
#
# If omitted, normal username/password Subsonic auth still works. Existing
# pre-migration credentials encrypted with JWT_SECRET can still be read and are
# re-encrypted with this key after the user signs in through Supernova again.
SUBSONIC_CREDENTIAL_KEY=

# -----------------------------------------------------------------------------
# OPTIONAL: Last.fm Integration
# Required only if you enable the Last.fm scrobbler plugin.
# Create an API account at: https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key_here
LASTFM_API_SECRET=your_lastfm_api_secret_here

# -----------------------------------------------------------------------------
# OPTIONAL: Plugin Toggles
# All plugins are ENABLED by default. Uncomment to DISABLE any of them.
# SUPERNOVA_PLUGIN_SUBSONIC=false
# SUPERNOVA_PLUGIN_LASTFM=false
# SUPERNOVA_PLUGIN_LRCLIB=false
# SUPERNOVA_PLUGIN_RADIOBROWSER=false
# SUPERNOVA_PLUGIN_PODCASTS=false
# SUPERNOVA_PLUGIN_AUTOTAGGER=false
# SUPERNOVA_PLUGIN_ARTISTMERGER=false
# SUPERNOVA_PLUGIN_DEDUPER=false

# -----------------------------------------------------------------------------
# OPTIONAL: PodcastIndex Integration
# Required only if you want authenticated higher rate-limits for the Podcasts plugin.
# PODCAST_INDEX_API_KEY=your_podcast_index_api_key_here
# PODCAST_INDEX_API_SECRET=your_podcast_index_api_secret_here

# -----------------------------------------------------------------------------
# OPTIONAL: Media Library Path
# The absolute path on your HOST machine to your music library.
# This gets bind-mounted read-only into the container.
# Default: ./music (a local folder next to docker-compose.yml)
# MEDIA_PATH=/home/youruser/Music

# -----------------------------------------------------------------------------
# OPTIONAL: CORS Allowed Origin
# Restricts which frontend domains can make API requests to the backend.
# Crucial for security if exposing the backend directly to the internet.
# Default: http://localhost:5174 (for local docker use)
# CORS_ALLOWED_ORIGIN=https://music.yourdomain.com

# First account is the admin. Later registrations require this shared invite.
# Empty disables new registrations after initial setup. Rotate by changing it
# and recreating the backend container; existing accounts are unaffected.
REGISTRATION_INVITE_CODE=
